# ---------------------------------------------------------------------------
# Client-exposed Supabase configuration (copy to `.env.local` for local dev)
# Dashboard -> Project Settings -> API
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# ---------------------------------------------------------------------------
# Server-side ONLY secrets (set in Vercel Project Settings -> Environment Variables)
# NEVER prefix these with VITE_
# ---------------------------------------------------------------------------
SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR-SUPABASE-SERVICE-ROLE-KEY
APP_URL=https://your-production-domain.vercel.app

# Exchange rate used to convert USD catalog prices to ETB for Ethiopian gateways
ETB_EXCHANGE_RATE=125

# Chapa (supports Telebirr, CBE Birr, Amole, local & international cards)
CHAPA_SECRET_KEY=CHASECK_TEST-xxxxxxxx
CHAPA_WEBHOOK_SECRET=your-chapa-webhook-secret

# Optional direct Ethio Telecom Telebirr H5 WebPay credentials
TELEBIRR_APP_ID=
TELEBIRR_APP_KEY=
TELEBIRR_SHORT_CODE=
TELEBIRR_PUBLIC_KEY=

# Stripe (Credit/Debit Cards: Visa, Mastercard, Amex, Apple Pay, Google Pay)
STRIPE_SECRET_KEY=sk_live_or_test_xxxxxxxx
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxx

# PayPal (International express checkout)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
PAYPAL_ENV=sandbox

# Server-side cryptographic license signature secret (32+ random chars)
LICENSE_SIGNING_SECRET=replace-with-long-random-secret
